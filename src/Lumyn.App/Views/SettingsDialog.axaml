<Window
    x:Class="Lumyn.App.Views.SettingsDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    Width="760"
    Height="560"
    MinWidth="640"
    MinHeight="460"
    CanResize="True"
    WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="1*,4*" MinHeight="0">

      <Border Grid.Column="0"
              Background="{StaticResource Lumyn.Bg}"
              BorderBrush="{StaticResource Lumyn.Line}"
              BorderThickness="0,0,1,0"
              Padding="10,14">
        <Grid RowDefinitions="*,Auto">
          <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Classes="h2" Text="Settings" Margin="10,0,0,10" />

            <Button Name="WatchModesNavButton" Classes="nav" Click="WatchModesNavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <PathIcon Width="15" Height="15" Data="{StaticResource Icon.Contrast}" />
                <TextBlock Text="Watch modes" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="PlaybackNavButton" Classes="nav" Click="PlaybackNavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <PathIcon Width="15" Height="15" Data="{StaticResource Icon.Play}" />
                <TextBlock Text="Playback" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="VideoNavButton" Classes="nav" Click="VideoNavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <PathIcon Width="15" Height="15" Data="{StaticResource Icon.VideoAdjust}" />
                <TextBlock Text="Video" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="AudioClarityNavButton" Classes="nav" Click="AudioClarityNavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <PathIcon Width="15" Height="15" Data="{StaticResource Icon.AudioTrack}" />
                <TextBlock Text="Audio clarity" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="InterfaceNavButton" Classes="nav" Click="InterfaceNavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <PathIcon Width="15" Height="15" Data="{StaticResource Icon.Settings}" />
                <TextBlock Text="Interface" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="ShortcutsNavButton" Classes="nav" Click="ShortcutsNavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <PathIcon Width="15" Height="15" Data="{StaticResource Icon.Keyboard}" />
                <TextBlock Text="Shortcuts" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <Button Grid.Row="1" Name="TransmuxNavButton" Classes="nav" Click="TransmuxNavButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Image Width="15" Height="15" Source="{StaticResource Icon.TransmuxLogo}" />
              <TextBlock Text="Transmux" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="20,16,20,0" MinHeight="0">
        <ScrollViewer Name="WatchModesPanel" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Classes="h1" Text="Watch modes" Margin="0,0,0,4" />
            <TextBlock Classes="lede" Text="Presets tune Lumyn for the way you are watching." Margin="0,0,0,16" />
            <StackPanel Name="WatchModesList" Spacing="8" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Name="PlaybackPanel" VerticalScrollBarVisibility="Auto" IsVisible="False">
          <StackPanel>
            <TextBlock Classes="h1" Text="Playback" Margin="0,0,0,4" />
            <TextBlock Classes="lede" Text="Remember where you left off and resume there next time you open a file." Margin="0,0,0,16" />

            <StackPanel Spacing="8">
              <!-- Audio (above), default off -->
              <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <PathIcon Grid.Column="0" Width="16" Height="16"
                            Data="{StaticResource Icon.AudioTrack}"
                            Foreground="{StaticResource Lumyn.Muted}" VerticalAlignment="Center"
                            Margin="0,0,10,0" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Classes="title" Text="Resume audio files" />
                    <TextBlock Classes="hint" Text="Remember the last position for songs and other audio. Off by default." />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="2" Name="ResumeAudioToggle"
                                VerticalAlignment="Center" />
                </Grid>
              </Border>

              <!-- Video (below), default on -->
              <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <PathIcon Grid.Column="0" Width="16" Height="16"
                            Data="{StaticResource Icon.VideoAdjust}"
                            Foreground="{StaticResource Lumyn.Muted}" VerticalAlignment="Center"
                            Margin="0,0,10,0" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Classes="title" Text="Resume video files" />
                    <TextBlock Classes="hint" Text="Pick up movies and clips where you left off. On by default." />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="2" Name="ResumeVideoToggle"
                                VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Name="VideoPanel" VerticalScrollBarVisibility="Auto" IsVisible="False">
          <StackPanel>
            <TextBlock Classes="h1" Text="Video adjustments" Margin="0,0,0,16" />

            <TextBlock Classes="h2" Text="Color correction" Margin="0,0,0,10" />

            <Grid ColumnDefinitions="96,*,60" Margin="0,0,0,10">
              <TextBlock Grid.Column="0" Text="Brightness" Classes="label" VerticalAlignment="Center" />
              <Slider Grid.Column="1"
                      Name="BrightnessSlider"
                      Minimum="-100" Maximum="100"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      ValueChanged="BrightnessSlider_Changed"
                      VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Name="BrightnessVal" Classes="value"
                         Text="+0"
                         VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Grid ColumnDefinitions="96,*,60" Margin="0,0,0,10">
              <TextBlock Grid.Column="0" Text="Contrast" Classes="label" VerticalAlignment="Center" />
              <Slider Grid.Column="1"
                      Name="ContrastSlider"
                      Minimum="-100" Maximum="100"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      ValueChanged="ContrastSlider_Changed"
                      VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Name="ContrastVal" Classes="value"
                         Text="+0"
                         VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Grid ColumnDefinitions="96,*,60" Margin="0,0,0,20">
              <TextBlock Grid.Column="0" Text="Saturation" Classes="label" VerticalAlignment="Center" />
              <Slider Grid.Column="1"
                      Name="SaturationSlider"
                      Minimum="-100" Maximum="100"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      ValueChanged="SaturationSlider_Changed"
                      VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Name="SaturationVal" Classes="value"
                         Text="+0"
                         VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Classes="h2" Text="Geometry" Margin="0,0,0,10" />

            <Grid ColumnDefinitions="96,*,60" Margin="0,0,0,6">
              <TextBlock Grid.Column="0" Text="Zoom" Classes="label" VerticalAlignment="Center" />
              <Slider Grid.Column="1"
                      Name="ZoomSlider"
                      Minimum="-100" Maximum="100"
                      TickFrequency="5" IsSnapToTickEnabled="True"
                      ValueChanged="ZoomSlider_Changed"
                      VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Name="ZoomVal" Classes="value"
                         Text="100%"
                         VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Classes="hint"
                       Text="0 = original size  ·  positive = zoom in  ·  negative = zoom out"
                       Margin="96,0,0,14" />

            <Grid ColumnDefinitions="96,*" Margin="0,0,0,14">
              <TextBlock Grid.Column="0" Text="Aspect ratio" Classes="label" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        Name="AspectCombo"
                        MaxDropDownHeight="220"
                        Focusable="True"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="AspectCombo_SelectionChanged" />
            </Grid>

            <Grid ColumnDefinitions="96,*" Margin="0,0,0,20">
              <TextBlock Grid.Column="0" Text="Rotation" Classes="label" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Name="Rot0Btn" Classes="chip" Content="0°" MinWidth="58" Click="RotButton_Click" Tag="0" />
                <Button Name="Rot90Btn" Classes="chip" Content="90°" MinWidth="58" Click="RotButton_Click" Tag="90" />
                <Button Name="Rot180Btn" Classes="chip" Content="180°" MinWidth="58" Click="RotButton_Click" Tag="180" />
                <Button Name="Rot270Btn" Classes="chip" Content="270°" MinWidth="58" Click="RotButton_Click" Tag="270" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Name="AudioClarityPanel" VerticalScrollBarVisibility="Auto" IsVisible="False">
          <StackPanel>
            <TextBlock Classes="h1" Text="Audio clarity" Margin="0,0,0,4" />
            <TextBlock Classes="lede" Text="Make dialogue clear without opening an equalizer." Margin="0,0,0,16" />
            <StackPanel Name="AudioClarityList" Spacing="8" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Name="InterfacePanel" VerticalScrollBarVisibility="Auto" IsVisible="False">
          <StackPanel>
            <TextBlock Classes="h1" Text="Interface" Margin="0,0,0,4" />
            <TextBlock Classes="lede" Text="Hide controls you do not use for a cleaner player surface." Margin="0,0,0,16" />
            <StackPanel Name="InterfaceOptionsList" Spacing="8" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Name="ShortcutsPanel" VerticalScrollBarVisibility="Auto" IsVisible="False">
          <StackPanel Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="Keyboard shortcuts" Margin="0,0,0,16" />
            <StackPanel Name="ShortcutsList" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Name="TransmuxPanel" VerticalScrollBarVisibility="Auto" IsVisible="False">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
              <Image Width="42" Height="42" Source="{StaticResource Icon.TransmuxLogo}" />
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="h1" Text="Transmux" />
                <TextBlock Classes="lede" Text="Video format conversion" />
              </StackPanel>
            </StackPanel>

            <TextBlock Text="Lumyn stays focused on playback. For converting video and audio files, use Transmux."
                       Foreground="{StaticResource Lumyn.Text}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18" />

            <StackPanel Spacing="8">
              <Border Classes="card">
                <TextBlock Text="Convert MP4, WebM, MKV, AVI, MOV, MP3, AAC, FLAC, OGG, WAV, and Opus." FontSize="12" Foreground="{StaticResource Lumyn.Text}" TextWrapping="Wrap" />
              </Border>
              <Border Classes="card">
                <TextBlock Text="Use fast stream copy when possible, or full re-encode when you need a compatible output." FontSize="12" Foreground="{StaticResource Lumyn.Text}" TextWrapping="Wrap" />
              </Border>
              <Border Classes="card">
                <TextBlock Text="Include subtitles, extract them to SRT or ASS, or strip subtitle tracks from the output." FontSize="12" Foreground="{StaticResource Lumyn.Text}" TextWrapping="Wrap" />
              </Border>
              <Border Classes="card">
                <TextBlock Text="Inspect media streams and follow live conversion progress with speed and ETA." FontSize="12" Foreground="{StaticResource Lumyn.Text}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>

            <Button Content="Open Transmux website"
                    Classes="accent"
                    HorizontalAlignment="Left"
                    Margin="0,18,0,0"
                    Click="OpenTransmuxWebsite_Click" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Classes="footer">
      <Grid ColumnDefinitions="Auto,*,Auto,8,Auto">
        <Button Grid.Column="0" Name="ResetButton"
                Classes="danger"
                Content="Reset video"
                Click="ResetButton_Click" />
        <Button Grid.Column="2" Name="CancelButton"
                Content="Cancel"
                Click="CancelButton_Click" />
        <Button Grid.Column="4" Name="OkButton"
                Content="Apply"
                Classes="accent"
                Click="OkButton_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
