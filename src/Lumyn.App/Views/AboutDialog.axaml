<Window
    x:Class="Lumyn.App.Views.AboutDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About Lumyn"
    Width="380"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    SizeToContent="Height">
  <StackPanel Margin="24,20,24,20" Spacing="0">

    <!-- Logo + app name -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,0,0,6">
      <Image Width="32" Height="32" Source="{StaticResource Icon.LumynMark}" />
      <TextBlock Text="Lumyn" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
    </StackPanel>

    <TextBlock Name="VersionText" Classes="faint"
               HorizontalAlignment="Center" Margin="0,0,0,18" />

    <!-- Info rows -->
    <Border Classes="card" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Platform" Classes="faint" Margin="0,0,0,8" />
        <TextBlock Grid.Row="0" Grid.Column="1" Name="OsText" Classes="value" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Architecture" Classes="faint" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Grid.Column="1" Name="ArchText" Classes="value" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text=".NET runtime" Classes="faint" />
        <TextBlock Grid.Row="2" Grid.Column="1" Name="RuntimeText" Classes="value" />
      </Grid>
    </Border>

    <!-- Update status -->
    <StackPanel Spacing="10">
      <TextBlock Name="UpdateStatusText" Classes="hint"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />

      <Button Name="CheckUpdatesButton"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Click="CheckUpdates_Click">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Width="13" Height="13"
                    Data="{StaticResource Icon.CheckUpdates}"
                    VerticalAlignment="Center" />
          <TextBlock Name="CheckUpdatesButtonText"
                     Text="Check for updates"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>

    <Border Classes="divider" Margin="0,16,0,16" />

    <!-- Footer links -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
      <Button Classes="link" Click="GitHub_Click">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <PathIcon Width="13" Height="13"
                    Data="{StaticResource Icon.GitHub}"
                    VerticalAlignment="Center" />
          <TextBlock Text="GitHub" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock Text="·" Classes="faint" VerticalAlignment="Center" />
      <Button Classes="link" Click="Releases_Click">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <PathIcon Width="13" Height="13"
                    Data="{StaticResource Icon.Releases}"
                    VerticalAlignment="Center" />
          <TextBlock Text="Releases" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- License note -->
    <TextBlock Text="Source Available · © 2026 Piyush Doorwar" Classes="faint"
               HorizontalAlignment="Center" FontSize="11" Margin="0,10,0,4" />

  </StackPanel>
</Window>
