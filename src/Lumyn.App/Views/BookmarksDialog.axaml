<Window
    x:Class="Lumyn.App.Views.BookmarksDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Markers"
    Width="460"
    MinHeight="120"
    MaxHeight="520"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    SizeToContent="Height">
  <StackPanel Margin="16,14,16,16" Spacing="10">

    <!-- Header row: file name + Add button -->
    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
      <TextBlock Grid.Column="0" Name="FileNameText" Classes="faint"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center"
                 Margin="0,0,10,0" />
      <Button Grid.Column="1"
              Name="AddButton"
              Classes="soft"
              Content="+ Bookmark"
              Click="AddButton_Click"
              VerticalAlignment="Center" />
    </Grid>

    <Border Classes="divider" />

    <ScrollViewer MaxHeight="420"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Bookmarks" />

        <TextBlock Name="EmptyBookmarksText" Classes="faint"
                   Text="No bookmarks yet. Press B while playing to add one."
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,8" />

        <ItemsControl Name="BookmarksList" />

        <Border Name="ChaptersDivider" Classes="divider" Margin="0,4,0,0" />

        <TextBlock Name="ChaptersHeader" Classes="h2" Text="Chapters" />

        <ItemsControl Name="ChaptersList" />
      </StackPanel>
    </ScrollViewer>

  </StackPanel>
</Window>
