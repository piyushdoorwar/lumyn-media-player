<Window
    x:Class="Lumyn.App.Views.JumpToTimeDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Jump to Time"
    Width="320"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    SizeToContent="Height">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Classes="label" Text="Enter time" />
    <TextBox
        Name="TimeInput"
        PlaceholderText="mm:ss  or  h:mm:ss  or  seconds" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="OkButton" Content="Jump" Classes="accent" Click="OkButton_Click" />
      <Button Name="CancelButton" Content="Cancel" Click="CancelButton_Click" />
    </StackPanel>
  </StackPanel>
</Window>
