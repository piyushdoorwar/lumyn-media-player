<Window
    x:Class="Lumyn.App.Views.CastDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Lumyn.Core.Services"
    Title="Cast"
    Width="560"
    Height="390"
    MinWidth="500"
    MinHeight="340"
    CanResize="True"
    WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,16,18,12">
      <StackPanel Grid.Column="0" Spacing="3">
        <TextBlock Classes="h1" Text="Cast to a device" />
        <TextBlock Classes="lede" Text="Choose a device on your network." />
      </StackPanel>
      <Button Grid.Column="1"
              Name="RefreshButton"
              Content="Refresh"
              VerticalAlignment="Center"
              Click="RefreshButton_Click" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,14,190" Margin="18,0,18,14">
      <Border Grid.Column="0" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="12,10,12,8">
            <ProgressBar Grid.Column="0"
                         Name="SearchSpinner"
                         Classes="circular"
                         IsIndeterminate="True"
                         IsVisible="False"
                         Foreground="{StaticResource Lumyn.AccentBright}"
                         Width="14"
                         Height="14"
                         VerticalAlignment="Center"
                         Margin="0,0,7,0" />
            <TextBlock Grid.Column="1"
                       Name="DevicesStatusText"
                       Classes="hint"
                       Text="Searching for devices..."
                       VerticalAlignment="Center" />
          </Grid>
          <ListBox Grid.Row="1"
                   Name="DevicesList"
                   ItemsSource="{Binding CastDevices}"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionChanged="DevicesList_SelectionChanged"
                   DoubleTapped="DevicesList_DoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:ChromecastDevice">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="7,7">
                  <PathIcon Grid.Column="0"
                            Width="17"
                            Height="17"
                            Data="{StaticResource Icon.Cast}"
                            Foreground="{StaticResource Lumyn.AccentBright}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="card" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Status" />
          <TextBlock Name="CastStateText"
                     Text="Not casting"
                     FontSize="14"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Name="CastDetailText"
                     Classes="hint"
                     Text="Open a media file, then choose a device to start casting." />
          <Border Classes="divider" Margin="0,2" />
          <Button Name="DisconnectButton"
                  Content="Disconnect"
                  Click="DisconnectButton_Click" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="footer">
      <Grid ColumnDefinitions="Auto,*,Auto,8,Auto">
        <TextBlock Grid.Column="0"
                   Name="FooterStatusText"
                   Classes="hint"
                   VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Name="CloseButton"
                Content="Close"
                Click="CloseButton_Click" />
        <Button Grid.Column="4"
                Name="CastButton"
                Content="Cast"
                Classes="accent"
                Click="CastButton_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
