<Window
    x:Class="Lumyn.App.Views.SubtitleSettingsDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lumyn.Core.Models"
    xmlns:viewModels="using:Lumyn.App.ViewModels"
    Title="Subtitles"
    Width="620"
    Height="540"
    MinWidth="500"
    MinHeight="420"
    CanResize="True"
    WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto">

    <TabControl Grid.Row="0" Margin="14,10,14,0">

      <!-- File tab: current file + inline search -->
      <TabItem Header="Subtitle file">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="0,12,0,0">

          <!-- Embedded tracks from the current media file -->
          <StackPanel Grid.Row="0"
                      Name="EmbeddedTracksPanel"
                      Spacing="6"
                      Margin="0,0,0,12"
                      IsVisible="False">
            <TextBlock Classes="h2" Text="Embedded subtitles" />
            <ListBox Name="EmbeddedTracksList"
                     MaxHeight="96"
                     Background="{StaticResource Lumyn.Surface2}"
                     BorderBrush="{StaticResource Lumyn.Line}"
                     BorderThickness="1"
                     CornerRadius="{StaticResource Lumyn.Radius}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="viewModels:TrackInfo">
                  <Grid ColumnDefinitions="*,Auto" Margin="6,5">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Classes="badge"
                            IsVisible="{Binding IsSelected}"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                      <TextBlock Text="Selected" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <!-- Current file path + browse -->
          <Grid Grid.Row="1" ColumnDefinitions="*,8,Auto" Margin="0,0,0,10">
            <TextBox Grid.Column="0"
                     Name="FilePathBox"
                     IsReadOnly="True"
                     PlaceholderText="No subtitle file loaded" />
            <Button Grid.Column="2"
                    Name="BrowseButton"
                    Content="Browse…"
                    Click="BrowseButton_Click" />
          </Grid>

          <!-- Divider -->
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" Margin="0,0,0,10">
            <Border Grid.Column="0" Classes="divider" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="or search online" Classes="hint"
                       Margin="12,0" VerticalAlignment="Center" />
            <Border Grid.Column="2" Classes="divider" VerticalAlignment="Center" />
          </Grid>

          <!-- Search query + language + button -->
          <Grid Grid.Row="3" ColumnDefinitions="*,8,Auto,8,Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0"
                     Name="SearchBox"
                     PlaceholderText="Movie or show name…" />
            <ComboBox Grid.Column="2"
                      Name="LanguageBox"
                      MinWidth="130"
                      MaxDropDownHeight="220"
                      Focusable="True" />
            <Button Grid.Column="4"
                    Name="SearchButton"
                    Content="Search"
                    Classes="accent"
                    MinWidth="80"
                    Click="SearchButton_Click" />
          </Grid>

          <!-- Status -->
          <Grid Grid.Row="4" ColumnDefinitions="Auto,*" MinHeight="18" Margin="0,0,0,6">
            <ProgressBar Grid.Column="0"
                         Name="LoadingBar"
                         IsIndeterminate="True"
                         IsVisible="False"
                         Width="100" Height="3"
                         Foreground="{StaticResource Lumyn.Accent}"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0" />
            <TextBlock Grid.Column="1"
                       Name="StatusText"
                       Classes="hint"
                       Text="Enter a title and press Search."
                       VerticalAlignment="Center" />
          </Grid>

          <!-- Results -->
          <ListBox Grid.Row="5"
                   Name="ResultsList"
                   Background="{StaticResource Lumyn.Surface2}"
                   BorderBrush="{StaticResource Lumyn.Line}"
                   BorderThickness="1"
                   CornerRadius="{StaticResource Lumyn.Radius}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   DoubleTapped="ResultsList_DoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:SubtitleSearchResult">
                <Grid ColumnDefinitions="*,10,Auto,8,Auto" Margin="4,6">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{Binding Title}" Classes="title"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding FileName}"
                               FontSize="11" Foreground="{StaticResource Lumyn.Muted}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                      <Border Classes="badge">
                        <TextBlock Text="{Binding Language}" />
                      </Border>
                      <Border Background="{StaticResource Lumyn.Surface3}"
                              CornerRadius="{StaticResource Lumyn.RadiusSm}" Padding="6,2">
                        <TextBlock Text="{Binding Format}" FontSize="10.5" Foreground="{StaticResource Lumyn.Text}" />
                      </Border>
                      <Border BorderBrush="{StaticResource Lumyn.Line}" BorderThickness="1"
                              CornerRadius="{StaticResource Lumyn.RadiusSm}" Padding="6,1">
                        <TextBlock Text="{Binding Source}" FontSize="10.5" Foreground="{StaticResource Lumyn.Muted}" />
                      </Border>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Downloads, StringFormat='{}{0:N0}'}"
                               FontSize="12" Foreground="{StaticResource Lumyn.Muted}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="downloads" FontSize="10" Foreground="{StaticResource Lumyn.Faint}"
                               HorizontalAlignment="Right" />
                  </StackPanel>
                  <Button Grid.Column="4"
                          Classes="downloadIcon"
                          VerticalAlignment="Center"
                          CommandParameter="{Binding}"
                          Click="DownloadResultButton_Click">
                    <Viewbox Width="22" Height="22">
                      <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource Icon.DownloadTray}"
                              Stroke="{StaticResource Lumyn.Text}"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                        <Path Data="{StaticResource Icon.DownloadArrow}"
                              Stroke="{StaticResource Lumyn.Text}"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                      </Canvas>
                    </Viewbox>
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Use selected -->
          <StackPanel Grid.Row="6" Orientation="Horizontal"
                      HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Name="UseButton"
                    Content="Use selected subtitle"
                    IsEnabled="False"
                    Click="UseButton_Click" />
          </StackPanel>

        </Grid>
      </TabItem>

      <!-- Appearance tab -->
      <TabItem Header="Appearance">
        <Grid RowDefinitions="Auto,16,*" Margin="0,14,0,0">

          <!-- Live preview -->
          <Border Grid.Row="0"
                  MinHeight="132"
                  Background="{StaticResource Lumyn.Bg}"
                  BorderBrush="{StaticResource Lumyn.Line}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource Lumyn.Radius}"
                  ClipToBounds="True">
            <Grid RowDefinitions="*,Auto" Margin="16,14">
              <Border Grid.Row="0"
                      Width="190"
                      Height="70"
                      Background="{StaticResource Lumyn.Surface2}"
                      CornerRadius="{StaticResource Lumyn.RadiusSm}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Opacity="0.9" />
              <TextBlock Grid.Row="0"
                         Name="PreviewText"
                         Text="Every line should feel easy to read."
                         TextAlignment="Center"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         MaxWidth="460"
                         FontWeight="SemiBold">
                <TextBlock.Effect>
                  <DropShadowEffect BlurRadius="4" OffsetX="1" OffsetY="1" Color="Black" Opacity="0.9" />
                </TextBlock.Effect>
              </TextBlock>
              <TextBlock Grid.Row="1"
                         Text="Preview"
                         Classes="faint"
                         FontSize="11"
                         HorizontalAlignment="Center"
                         Margin="0,8,0,0" />
            </Grid>
          </Border>

          <!-- Controls -->
          <StackPanel Grid.Row="2" Spacing="10">

            <Border Classes="card">
              <Grid ColumnDefinitions="120,*">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="title" Text="Text size" />
                  <TextBlock Classes="hint" Text="Subtitle scale" />
                </StackPanel>
                <Grid Grid.Column="1" ColumnDefinitions="*,8,*,8,*">
                  <Button Grid.Column="0" Name="SizeSmallBtn" Classes="chip" HorizontalAlignment="Stretch" Content="Small"
                          Click="SizeButton_Click" Tag="Small" />
                  <Button Grid.Column="2" Name="SizeMediumBtn" Classes="chip" HorizontalAlignment="Stretch" Content="Medium"
                          Click="SizeButton_Click" Tag="Medium" />
                  <Button Grid.Column="4" Name="SizeLargeBtn" Classes="chip" HorizontalAlignment="Stretch" Content="Large"
                          Click="SizeButton_Click" Tag="Large" />
                </Grid>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="120,*">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="title" Text="Font" />
                  <TextBlock Classes="hint" Text="Typeface" />
                </StackPanel>
                <ComboBox Grid.Column="1" Name="FontCombo"
                          MaxDropDownHeight="220"
                          Focusable="True"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="FontCombo_SelectionChanged" />
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="120,*">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="title" Text="Colour" />
                  <TextBlock Classes="hint" Text="Foreground" />
                </StackPanel>
                <ComboBox Grid.Column="1" Name="ColorCombo"
                          MaxDropDownHeight="220"
                          Focusable="True"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="ColorCombo_SelectionChanged" />
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="120,Auto,8,*,8,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="title" Text="Sync delay" />
                  <TextBlock Classes="hint" Text="Earlier / later" />
                </StackPanel>
                <Button Grid.Column="1" Name="DelayMinusBtn" Content="&#8722;"
                        Width="36" Height="34" Click="DelayMinus_Click" FontSize="18"
                        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <Border Grid.Column="3"
                        Background="{StaticResource Lumyn.Surface}"
                        CornerRadius="{StaticResource Lumyn.RadiusSm}"
                        BorderBrush="{StaticResource Lumyn.Line}" BorderThickness="1"
                        Padding="8,6">
                  <TextBlock Name="DelayLabel" Text="0 ms"
                             HorizontalAlignment="Center"
                             FontFamily="{StaticResource Lumyn.Mono}"
                             FontSize="13" FontWeight="SemiBold" />
                </Border>
                <Button Grid.Column="5" Name="DelayPlusBtn" Content="+"
                        Width="36" Height="34" Click="DelayPlus_Click" FontSize="18"
                        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
              </Grid>
            </Border>

          </StackPanel>

        </Grid>
      </TabItem>

    </TabControl>

    <!-- Bottom action bar -->
    <Border Grid.Row="1" Classes="footer" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Name="DisableButton" Content="Disable subtitles"
                Classes="danger" Click="DisableButton_Click" />
        <Button Name="CancelButton" Content="Cancel" Click="CancelButton_Click" />
        <Button Name="ApplyButton"  Content="Apply"  Classes="accent" Click="ApplyButton_Click" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
